# Server Port
PORT=5000

# Node Environment (development | production)
NODE_ENV=production

# MongoDB Atlas Connection String
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/findnearjob?retryWrites=true&w=majority

# JWT Secret Key for Authentication
JWT_SECRET=your_jwt_super_secret_key_here

# Frontend Application URL (for CORS)
CLIENT_URL=https://findnearjob.vercel.app
